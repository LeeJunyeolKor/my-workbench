# Local task data directory. TASKS.md is stored here.
MY_WORKBENCH_DATA=~/.my-workbench

# Directory containing implementation-plan folders.
WORKBENCH_PLANS_DIR=~/.my-workbench/plans

# Workspace roots to scan for Git repositories. Leave empty to disable scanning.
# Separate multiple paths with the operating system path delimiter (`:` on macOS/Linux).
WORKBENCH_WORKSPACE_ROOTS=
