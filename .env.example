# 로컬 작업 데이터 디렉터리. TASKS.md가 여기에 저장됩니다.
MY_WORKBENCH_DATA=~/.my-workbench

# 구현 계획 폴더를 저장할 디렉터리입니다.
WORKBENCH_PLANS_DIR=~/.my-workbench/plans

# 에이전트 작업대에서 허용할 Git 저장소 루트입니다. 비워 두면 저장소를 선택할 수 없습니다.
# 여러 경로는 운영체제 경로 구분자(macOS/Linux는 `:`)로 구분합니다.
# Tauri IPC 허용 범위에도 쓰려면 .env만이 아니라 데스크톱 앱 프로세스 환경으로 전달해야 합니다.
WORKBENCH_WORKSPACE_ROOTS=
